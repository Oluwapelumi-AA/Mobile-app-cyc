
APP_NAME=The Light App API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./the_light_app.db

# Replace this placeholder with a securely generated secret in your local .env
SECRET_KEY=replace-with-a-random-secret-before-enabling-auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081"]
# Hosts the API answers to. Set your API domain in production, e.g. ["api.cyc.org"].
ALLOWED_HOSTS=["*"]
# API docs at /docs. Off in production unless set to true.
# ENABLE_DOCS=false

# Sign-in security
RATE_LIMIT_ENABLED=true
# Wrong passwords in a row before a short lock, and how long it lasts.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# New email sign-ups confirm a 6-digit emailed code before they can sign in.
REQUIRE_EMAIL_VERIFICATION=true
# Admins must use two-step sign-in (authenticator app).
REQUIRE_ADMIN_MFA=true
MFA_ISSUER=CYC
# Google sign-in: your OAuth client IDs (web, iOS, Android) from Google Cloud
# Console → APIs & Services → Credentials. Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=[]
# Your website or app link, used in emails (certificate check links).
PUBLIC_APP_URL=https://cyc.org

AVATAR_MAX_UPLOAD_BYTES=5242880

# Video (meetings and livestreams). "fake" for development, "none" to turn off.
VIDEO_PROVIDER=fake
VIDEO_SERVER_URL=wss://video.local.invalid
VIDEO_TOKEN_TTL_SECONDS=600
VIDEO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Object storage (Amazon S3) for avatars, sermons, resources and course videos.
# "none" or "s3". See docs/aws-s3-cloudfront.md.
STORAGE_BACKEND=none
STORAGE_BUCKET=
STORAGE_REGION=eu-west-2
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGN_TTL_SECONDS=900
# Largest audio, video or document upload for the resource library (500 MB).
RESOURCE_MAX_UPLOAD_BYTES=524288000
# Course lesson videos (2 GB) and notes PDFs (50 MB).
COURSE_VIDEO_MAX_UPLOAD_BYTES=2147483648
COURSE_NOTES_MAX_UPLOAD_BYTES=52428800
# CloudFront in front of the private bucket: "none" or "cloudfront".
CDN_PROVIDER=none
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
# The private key matching the CloudFront public key: paste the PEM with \n
# for line breaks, or give a file path.
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_PRIVATE_KEY_PATH=
CLOUDFRONT_URL_TTL_SECONDS=14400

# Notifications. Push: "fake" for development, "none" to turn off.
PUSH_PROVIDER=fake
# Set PUSH_PROVIDER=expo for the Expo mobile app. EXPO_ACCESS_TOKEN is only
# needed if enhanced push security is turned on in the Expo project.
# EXPO_ACCESS_TOKEN=
# Email: "fake" for development (nothing is sent), "none" to turn off, or "smtp".
# Gmail: EMAIL_BACKEND=smtp, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURITY=starttls, SMTP_USERNAME=your Gmail address and SMTP_PASSWORD=
# a 16-character Google App Password (not your normal password).
# EMAIL_FROM must use the same Gmail address. See docs/gmail-smtp.md.
EMAIL_BACKEND=fake
EMAIL_FROM="Christ Youth Club <your-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# The worker: python -m app.workers.notifications
NOTIFICATION_WORKER_INTERVAL_SECONDS=15
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETENTION_DAYS=90
EVENT_REMINDER_MINUTES_BEFORE=60

# Languages notifications and emails are written in (each needs a catalog in
# app/i18n). Anyone else gets DEFAULT_LANGUAGE.
SUPPORTED_LANGUAGES=["en","fr","es","pt"]
DEFAULT_LANGUAGE=en
