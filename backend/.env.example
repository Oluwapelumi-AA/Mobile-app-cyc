
APP_NAME=The Light App API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./the_light_app.db

# Replace this placeholder with a securely generated secret in your local .env
SECRET_KEY=replace-with-a-random-secret-before-enabling-auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

AVATAR_MAX_UPLOAD_BYTES=5242880

# Video (meetings and livestreams). "fake" for development, "none" to turn off.
VIDEO_PROVIDER=fake
VIDEO_SERVER_URL=wss://video.local.invalid
VIDEO_TOKEN_TTL_SECONDS=600
VIDEO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Object storage for avatars and replays. "none" or "s3" (any S3-compatible service).
STORAGE_BACKEND=none
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGN_TTL_SECONDS=900
# Largest audio, video or document upload for the resource library (500 MB).
RESOURCE_MAX_UPLOAD_BYTES=524288000

# Notifications. Push: "fake" for development, "none" to turn off.
PUSH_PROVIDER=fake
# Email: "fake" for development, "none" to turn off, or "smtp".
EMAIL_BACKEND=fake
EMAIL_FROM="The Light App <no-reply@thelightapp.invalid>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# The worker: python -m app.workers.notifications
NOTIFICATION_WORKER_INTERVAL_SECONDS=15
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETENTION_DAYS=90
EVENT_REMINDER_MINUTES_BEFORE=60
