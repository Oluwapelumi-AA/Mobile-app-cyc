# Where the dashboard's server reaches the API (kept server-side).
API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Google sign-in on the dashboard (optional): the Web OAuth client ID.
# Add http://localhost:3000 and your dashboard domain to "Authorized
# JavaScript origins" in Google Cloud Console, and the same ID to
# GOOGLE_CLIENT_IDS on the server.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
