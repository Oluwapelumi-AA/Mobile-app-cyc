# Address of the CYC API, as your phone can reach it.
# On a phone with Expo Go, use your computer's local network IP, not localhost.
# Example: http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google sign-in (optional). OAuth client IDs from Google Cloud Console →
# APIs & Services → Credentials. The button only shows on platforms that have
# an ID. Add the same IDs to GOOGLE_CLIENT_IDS on the server.
# Note: Google sign-in on a phone needs a development build
# (npx expo run:android / run:ios or EAS); it doesn't work inside Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
